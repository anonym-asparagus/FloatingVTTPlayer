<Window x:Class="FloatingVttPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating VTT Player"
        Icon="Assets/AppIcon.ico"
        Width="940" Height="760"
        MinWidth="760" MinHeight="650"
        Background="{StaticResource WindowGradient}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28,24,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="52" Height="52" CornerRadius="15" Background="{StaticResource BrandGradient}">
                <TextBlock Text="♫" FontSize="25" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,2,0,0">
                <TextBlock Text="Floating VTT Player" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Audio and subtitles, without the visual clutter"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="1,4,0,0" />
            </StackPanel>
            <Button Grid.Column="2" Content="Hide to tray" ToolTip="Keep playing in the system tray"
                    Click="HideToTray_OnClick" Padding="18,0" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,22,0,16" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" CornerRadius="10" Background="#212E4A">
                    <TextBlock Text="♪" FontSize="19" Foreground="{StaticResource AccentHoverBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,14,0" VerticalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="AUDIO FOLDER" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="FolderPathText"
                               Text="Choose a folder containing MP3/WAV and matching VTT files"
                               FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <Button Grid.Column="2" Content="↻  Refresh" Click="Refresh_OnClick" />
                <Button Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}"
                        Content="Browse folder" Click="BrowseFolder_OnClick" Padding="18,0" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8,10,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="10,3,10,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Playlist" FontSize="16" FontWeight="SemiBold" />
                        <Border Background="#242D4A" CornerRadius="7" Margin="10,0,0,0" Padding="8,3">
                            <TextBlock Text="DOUBLE-CLICK TO PLAY" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Grid.Column="1" Margin="18,0,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="470" />
                </Grid>

                <ListBox x:Name="PlaylistBox" Grid.Row="1" MaxHeight="210"
                         MouseDoubleClick="PlaylistBox_OnMouseDoubleClick"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="10" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid Background="Transparent" Margin="2,0">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                                  Opacity="0" IsTabStop="False" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb MinHeight="34" Cursor="Hand">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border x:Name="ScrollThumb" Background="#52617D"
                                                                        CornerRadius="3" />
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ScrollThumb" Property="Background"
                                                                                Value="{StaticResource AccentBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                                  Opacity="0" IsTabStop="False" />
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding AudioPath}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="#202C47">
                                    <TextBlock Text="♪" FontSize="14" Foreground="{StaticResource AccentHoverBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="11,0,12,0"
                                           VerticalAlignment="Center" FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" CornerRadius="7" Padding="9,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#183B38" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSubtitle}" Value="False">
                                                    <Setter Property="Background" Value="#282D3C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="VTT SYNCED" />
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSubtitle}" Value="False">
                                                        <Setter Property="Text" Value="AUDIO ONLY" />
                                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Text="0:00" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                    <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1"
                            Style="{StaticResource TimelineSliderStyle}"
                            PreviewMouseLeftButtonDown="ProgressSlider_OnPreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="ProgressSlider_OnPreviewMouseLeftButtonUp" />
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="0:00"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="⏮" ToolTip="Previous track" Style="{StaticResource RoundControlButtonStyle}"
                            Click="Previous_OnClick" />
                    <Button x:Name="PlayPauseButton" Content="▶  Play" ToolTip="Play or pause"
                            Style="{StaticResource PlayButtonStyle}" Click="PlayPause_OnClick" Margin="8,0" />
                    <Button Content="⏭" ToolTip="Next track" Style="{StaticResource RoundControlButtonStyle}"
                            Click="Next_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="18,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Volume" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="VolumeValueText" Text="80%" HorizontalAlignment="Right"
                                   FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                    <Slider x:Name="VolumeSlider" Grid.Row="1" Minimum="0" Maximum="100"
                            Style="{StaticResource ModernSliderStyle}" IsMoveToPointEnabled="True"
                            ValueChanged="VolumeSlider_OnValueChanged" Margin="0,6,0,0" />
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource SubtleBorderBrush}" />

                <Grid Grid.Column="2" Margin="18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Subtitle size" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="FontSizeValueText" Text="52 px" HorizontalAlignment="Right"
                                   FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                    <Slider x:Name="FontSizeSlider" Grid.Row="1" Minimum="18" Maximum="120"
                            TickFrequency="2" Style="{StaticResource ModernSliderStyle}"
                            IsMoveToPointEnabled="True" ValueChanged="FontSizeSlider_OnValueChanged"
                            Margin="0,6,0,0" />
                </Grid>

                <Border Grid.Column="3" Background="{StaticResource SubtleBorderBrush}" />

                <StackPanel Grid.Column="4" Margin="20,0,2,0" VerticalAlignment="Center">
                    <CheckBox x:Name="ShowOverlayCheckBox" Content="Show floating subtitles"
                              Checked="ShowOverlay_OnChanged" Unchecked="ShowOverlay_OnChanged" />
                    <CheckBox x:Name="OverlayLockedCheckBox" Content="Lock subtitle position" Margin="0,9,0,0"
                              Checked="OverlayLocked_OnChanged" Unchecked="OverlayLocked_OnChanged" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
